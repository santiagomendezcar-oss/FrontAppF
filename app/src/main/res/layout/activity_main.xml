<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etEquipoId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ID del equipo" />

    <Button
        android:id="@+id/btnJugadoresEquipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jugadores por equipo" />

    <EditText
        android:id="@+id/etMinGoles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mínimo de goles" />

    <Button
        android:id="@+id/btnJugadoresGoles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jugadores con más goles" />

    <Button
        android:id="@+id/btnResultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resultados partidos" />

    <EditText
        android:id="@+id/etEquipoIdGoles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ID equipo para goles" />

    <Button
        android:id="@+id/btnTotalGoles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total goles equipo" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJugadores"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPartidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
